#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/stp.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/ext_power.h>

#define BASE 0
#define NUM_SYM 1
#define MOVEMENT 2
#define SETTINGS 3

/*
 * Ported from the Cosmos Dactyl keymap (cosmos_dactyl.keymap).
 *
 * Mapping notes:
 *   - The 6x4 main grid maps 1:1 onto the 360's main grid.
 *   - Cosmos thumbs (left: ctrl/bspc, cmd, lower | right: raise, alt/enter, space)
 *     sit on the 360's bottom thumb row (BSPC DEL END | PGDN ENTER SPACE).
 *   - Keys the Cosmos didn't have (inner columns, upper thumb keys) keep the
 *     360 defaults on the base layer and are transparent elsewhere.
 *   - Holding both layer thumbs activates the settings layer, as before. The
 *     360's dedicated Mod key (right inner top) also still opens it.
 */

/ {
    behaviors {
      #include "macros.dtsi"
      #include "version.dtsi"

      hm: homerow_mods {
          compatible = "zmk,behavior-hold-tap";
          label = "HOMEROW_MODS";
          #binding-cells = <2>;
          tapping-term-ms = <200>;
          quick_tap_ms = <175>;
          flavor = "tap-preferred";
          bindings = <&kp>, <&kp>;
      };

      mod_tap_or_repeat: mod_tap_or_repeat {
          compatible = "zmk,behavior-hold-tap";
          label = "MOD_TAP_OR_REPEAT";
          #binding-cells = <2>;
          tapping-term-ms = <200>;
          quick-tap-ms = <150>;
          bindings = <&kp>, <&kp>;
      };

      custom_mod_tap: custom_mod_tap {
          compatible = "zmk,behavior-hold-tap";
          label = "CUSTOM_MOD_TAP";
          #binding-cells = <2>;
          tapping-term-ms = <150>;
          flavor = "tap-preferred";
          bindings = <&kp>, <&kp>;
      };
    };

  keymap {
    compatible = "zmk,keymap";

    default_layer {
      display-name = "Base";
      bindings = <
        &kp EQUAL  &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &none                                                                                   &mo SETTINGS &kp N6 &kp N7 &kp N8    &kp N9  &kp N0   &kp MINUS
        &kp TAB    &kp Q  &kp W  &kp E  &kp R  &kp T  &none                                                                                   &none        &kp Y  &kp U  &kp I     &kp O   &kp P    &kp BSLH
        &kp ESC    &kp A  &kp S  &kp D  &kp F  &kp G  &none                    &kp LCTRL &kp LALT &kp LGUI &kp RCTRL                          &none        &kp H  &kp J  &kp K     &kp L   &kp SEMI &kp SQT
        &kp LSHFT  &kp Z  &kp X  &kp C  &kp V  &kp B                                     &kp HOME &kp PG_UP                                                &kp N  &kp M  &kp COMMA &kp DOT &kp FSLH &kp RSHFT
        &none      &none  &none  &none  &none         &mod_tap_or_repeat LCTRL BSPC &kp LCMD &mo MOVEMENT &mo NUM_SYM &custom_mod_tap RALT ENTER &kp SPACE         &none  &none     &none   &none    &none
      >;
    };

    num_sym {
      display-name = "Nums";
      bindings = <
        &none      &none           &none           &none           &none           &none           &trans                                     &trans &none           &none           &none           &none                 &none             &none
        &kp EQUAL  &mt F1 N1       &mt F2 N2       &mt F3 N3       &mt F4 N4       &mt F5 N5       &trans                                     &trans &mt F6 N6       &mt F7 N7       &mt F8 N8       &mt F9 N9             &mt F10 N0        &kp MINUS
        &none      &kp ESC         &kp TAB         &kp EQUAL       &none           &none           &trans   &trans &trans &trans &trans       &trans &none           &none           &kp MINUS       &kp NON_US_BACKSLASH  &kp SQT           &none
        &trans     &kp GRAVE       &kp DEL         &none           &none           &none                             &trans &trans                   &none           &none           &none           &kp LBKT              &kp RBKT          &trans
        &none      &none           &none           &none           &none                    &trans &trans &trans &trans &trans &trans                                &none           &none           &none                 &none             &none
      >;
    };

    movement {
      display-name = "Move";
      bindings = <
        &none      &none           &none           &none           &none           &none               &trans                                     &trans &kp F6          &kp F7          &kp F8          &kp F9          &kp F10  &none
        &none      &mt F1 N1       &mt F2 N2       &mt F3 N3       &mt F4 N4       &mt F5 N5           &trans                                     &trans &none           &kp PG_DN       &kp PG_UP       &kp F11         &kp F12  &none
        &none      &kp EQUAL       &mkp RCLK       &mkp MCLK       &mkp LCLK       &kp C_VOICE_COMMAND &trans   &trans &trans &trans &trans       &trans &kp LEFT        &kp DOWN        &kp UP          &kp RIGHT       &none    &none
        &trans     &kp GRAVE       &kp LC(LEFT)    &kp LC(UP)      &kp LC(RIGHT)   &kp LG(LA(LC(V)))                     &trans &trans                   &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP    &msc SCRL_RIGHT &none    &trans
        &none      &none           &none           &trans          &none                        &trans &trans &trans &trans &trans &trans                            &none           &trans          &none           &none    &none
      >;
    };

    settings {
      display-name = "Mod";
      bindings = <
        &bootloader    &bt BT_SEL 0       &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4  &none                                     &trans        &none &none      &none      &none &none &bootloader
        &sys_reset     &rgb_ug RGB_TOG    &rgb_ug RGB_BRI &rgb_ug RGB_HUI &rgb_ug RGB_SAI &none         &bootloader                               &bootloader   &none &bl BL_TOG &bl BL_INC &none &none &sys_reset
        &studio_unlock &rgb_ug RGB_EFF    &rgb_ug RGB_BRD &rgb_ug RGB_HUD &rgb_ug RGB_SAD &none         &none       &none &none &none &none       &stp STP_BAT  &none &none      &bl BL_DEC &none &none &none
        &bt BT_CLR     &ext_power EP_ON   &none           &none           &macro_ver      &none                           &none &none                           &none &none      &none      &none &none &none
        &none          &ext_power EP_OFF  &none           &none           &none                         &none &none &none &none &none &none                   &none      &none      &none &none &none
      >;
    };

    extra1 {
      display-name = "Red";
      status = "reserved";
    };

    extra2 {
      display-name = "Purple";
      status = "reserved";
    };

    extra3 {
      display-name = "Cyan";
      status = "reserved";
    };

    extra4 {
      display-name = "Yellow";
      status = "reserved";
    };
  };

  conditional_layers {
    compatible = "zmk,conditional-layers";

    settings_on_both_layers {
      if-layers = <NUM_SYM MOVEMENT>;
      then-layer = <SETTINGS>;
    };
  };
};
